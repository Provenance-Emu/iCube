# Copy to .env for local runs (e.g. with `node --env-file=.env src/index.js`,
# Node 20.6+) or export these into your shell/host environment.

DISCORD_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=Provenance-Emu/iCube

# JSON: {channelId: {label, repo?}}. Leave unset to use the built-in default
# for guild 421819941835243520 (see README.md — rename the placeholder labels).
# CHANNEL_MAP={"1421601237966782524":{"label":"discord:channel-1"}}

STORE_PATH=./data/store.json
DRY_RUN=false
IGNORE_PREFIX=!
