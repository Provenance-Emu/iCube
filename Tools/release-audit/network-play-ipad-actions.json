[
  {
    "op": "launch",
    "arguments": [
      "-onboarding_seen_v1",
      "YES",
      "-ICubeAppearance",
      "dark",
      "-ICubeNetworkPlayPreview",
      "-SCREENSHOT_MODE",
      "1"
    ]
  },
  {
    "op": "assert",
    "label": "Network Play is not available in this iCube build.",
    "timeout": 10
  },
  {
    "op": "assert",
    "identifier": "networkPlay.filter.all"
  },
  {
    "op": "assert",
    "label": "No games in your library yet"
  },
  {
    "op": "capture",
    "name": "network-play-ipad-games",
    "ax": true
  },
  {
    "op": "tap",
    "identifier": "networkPlay.tab.rooms"
  },
  {
    "op": "assert",
    "label": "Room discovery unavailable"
  },
  {
    "op": "capture",
    "name": "network-play-ipad-rooms",
    "ax": true
  },
  {
    "op": "tap",
    "identifier": "networkPlay.tab.settings"
  },
  {
    "op": "assert",
    "label": "Connection settings unavailable"
  },
  {
    "op": "capture",
    "name": "network-play-ipad-settings",
    "ax": true
  },
  {
    "op": "tap",
    "identifier": "networkPlay.tab.games"
  },
  {
    "op": "tap",
    "identifier": "networkPlay.filter.favorites"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.filter.all"
  },
  {
    "op": "tap",
    "identifier": "networkPlay.back"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.games",
    "exists": false
  }
]
