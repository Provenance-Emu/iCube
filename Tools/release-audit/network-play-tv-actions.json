[
  {
    "op": "launch",
    "arguments": [
      "-onboarding_seen_v1",
      "YES",
      "-ICubeAppearance",
      "dark",
      "-ICubeNetworkPlayPreview",
      "-SCREENSHOT_MODE",
      "1"
    ]
  },
  {
    "op": "assert",
    "label": "Network Play is not available in this iCube build.",
    "timeout": 10
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.games",
    "focused": true
  },
  {
    "op": "capture",
    "name": "network-play-tv-games",
    "ax": true
  },
  {
    "op": "remote",
    "button": "right"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.rooms",
    "focused": true
  },
  {
    "op": "remote",
    "button": "select"
  },
  {
    "op": "assert",
    "label": "Room discovery unavailable"
  },
  {
    "op": "capture",
    "name": "network-play-tv-rooms",
    "ax": true
  },
  {
    "op": "remote",
    "button": "right"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.settings",
    "focused": true
  },
  {
    "op": "remote",
    "button": "select"
  },
  {
    "op": "assert",
    "label": "Connection settings unavailable"
  },
  {
    "op": "capture",
    "name": "network-play-tv-settings",
    "ax": true
  },
  {
    "op": "remote",
    "button": "left"
  },
  {
    "op": "remote",
    "button": "left"
  },
  {
    "op": "remote",
    "button": "select"
  },
  {
    "op": "remote",
    "button": "down"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.search",
    "focused": true
  },
  {
    "op": "capture",
    "name": "network-play-tv-search-focused",
    "ax": true
  },
  {
    "op": "remote",
    "button": "down"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.filter.all",
    "focused": true
  },
  {
    "op": "remote",
    "button": "down"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.game",
    "focused": true
  },
  {
    "op": "capture",
    "name": "network-play-tv-game-focused",
    "ax": true
  },
  {
    "op": "remote",
    "button": "select"
  },
  {
    "op": "assert",
    "label": "Host unavailable"
  },
  {
    "op": "capture",
    "name": "network-play-tv-game-details",
    "ax": true
  },
  {
    "op": "remote",
    "button": "menu"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.games",
    "focused": true
  },
  {
    "op": "remote",
    "button": "menu"
  },
  {
    "op": "assert",
    "identifier": "networkPlay.tab.games",
    "exists": false
  }
]
